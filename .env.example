# Local Ollama / Gemma
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=gemma4:e2b

# Optional cloud text-to-speech. Leave both blank for fully local mode.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Convex deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-site.convex.site

# Optional: only needed for Composio service integrations
COMPOSIO_API_KEY=

# Optional: only needed for a hosted Ollama-compatible service
OLLAMA_API_KEY=
